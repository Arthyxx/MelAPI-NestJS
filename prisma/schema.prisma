generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

enum StatusPedido {
  PENDENTE
  PAGO
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Cliente {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(120)
  email    String  @unique @db.VarChar(160)
  password String? @db.VarChar(255)

  googleSub String? @unique @db.VarChar(255)

  role   Role    @default(CLIENTE)
  active Boolean @default(true)

  phone         String? @db.VarChar(20)
  street        String? @db.VarChar(160)
  addressNumber String? @db.VarChar(20)
  complement    String? @db.VarChar(120)
  neighborhood  String? @db.VarChar(100)
  city          String? @db.VarChar(100)
  state         String? @db.VarChar(2)
  zipCode       String? @db.VarChar(9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos    Pedido[]
  avaliacoes AvaliacaoProduto[]

  @@map("clientes")
}

model Categoria {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id            Int     @id @default(autoincrement())
  name          String  @unique @db.VarChar(120)
  description   String? @db.Text
  price         Decimal @db.Decimal(10, 2)
  stockQuantity Int
  imageUrl      String? @db.VarChar(500)
  imagePublicId String? @db.VarChar(500)

  weightKg Decimal? @db.Decimal(8, 3)
  heightCm Decimal? @db.Decimal(8, 2)
  widthCm  Decimal? @db.Decimal(8, 2)
  lengthCm Decimal? @db.Decimal(8, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId Int
  category   Categoria @relation(fields: [categoryId], references: [id])

  pedidoItems PedidoItem[]
  avaliacoes  AvaliacaoProduto[]

  @@map("produtos")
}

model Pedido {
  id     Int          @id @default(autoincrement())
  status StatusPedido @default(PENDENTE)

  totalPrice    Decimal @db.Decimal(10, 2)
  shippingPrice Decimal @default(0) @db.Decimal(10, 2)

  shippingServiceId    String? @db.VarChar(50)
  shippingServiceName  String? @db.VarChar(100)
  shippingCompanyName  String? @db.VarChar(100)
  shippingDeliveryTime Int?

  shippingZipCode       String? @db.VarChar(8)
  shippingStreet        String? @db.VarChar(160)
  shippingAddressNumber String? @db.VarChar(20)
  shippingComplement    String? @db.VarChar(120)
  shippingNeighborhood  String? @db.VarChar(100)
  shippingCity          String? @db.VarChar(100)
  shippingState         String? @db.VarChar(2)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  paymentExpiresAt DateTime?

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  items      PedidoItem[]
  pagamentos Pagamento[]

  @@map("pedidos")
}

model PedidoItem {
  id       Int @id @default(autoincrement())
  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@map("pedido_items")
}

model Pagamento {
  id Int @id @default(autoincrement())

  provider String @default("MERCADO_PAGO") @db.VarChar(30)

  preferenceId String? @unique @db.VarChar(120)
  paymentId    String? @unique @db.VarChar(120)

  status       String  @default("pending") @db.VarChar(50)
  statusDetail String? @db.VarChar(120)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("pagamentos")
}

model AvaliacaoProduto {
  id      Int     @id @default(autoincrement())
  rating  Int
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([produtoId, clienteId])
  @@map("avaliacoes_produto")
}
