# Ambiente da aplicação
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mel

# JWT
# Use no mínimo 32 caracteres. Em produção, gere um segredo aleatório forte.
JWT_SECRET=substitua-por-um-segredo-seguro-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=1d

# Servidor
PORT=3000

# Frontend autorizado pelo CORS
FRONTEND_URL=http://localhost:5173

# Administrador inicial utilizado pelo seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=substitua-por-uma-senha-segura