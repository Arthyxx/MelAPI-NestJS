# ============================================================
# APLICAÇÃO
# ============================================================

# Valores permitidos:
# development | production | test
NODE_ENV=development

# Porta HTTP da API
PORT=3000


# ============================================================
# BANCO DE DADOS
# ============================================================

# PostgreSQL
# Nunca salve a URL real de produção no repositório.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mel


# ============================================================
# AUTENTICAÇÃO JWT
# ============================================================

# Deve possuir no mínimo 32 caracteres.
# Em produção, utilize um segredo longo e aleatório.
JWT_SECRET=substitua-por-um-segredo-seguro-com-32-caracteres-ou-mais

# Tempo de validade do token.
JWT_EXPIRES_IN=1d


# ============================================================
# FRONTEND / CORS
# ============================================================

# Desenvolvimento:
FRONTEND_URL=http://localhost:5173

# Em produção, FRONTEND_URL é obrigatório e deve utilizar HTTPS.
# Exemplo:
# FRONTEND_URL=https://www.seudominio.com.br


# ============================================================
# CLOUDINARY
# ============================================================

# Dados da conta utilizada para armazenamento das imagens.
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret


# ============================================================
# FRETE
# ============================================================

# CEP de origem dos pedidos, somente números.
# Sítio Macajetuba II - Viçosa do Ceará/CE
SHIPPING_ORIGIN_ZIP_CODE=62300000


# ============================================================
# MELHOR ENVIO
# ============================================================

# Desenvolvimento / Sandbox:
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br

# Em produção, utilize a URL HTTPS correspondente ao
# ambiente real configurado no Melhor Envio.

# Identificação enviada no User-Agent da integração.
MELHOR_ENVIO_USER_AGENT=Apiario Vitoria Seven (apiariovitoriaseven@gmail.com)

# Obrigatório em produção.
# Nunca envie o token real para o repositório.
MELHOR_ENVIO_ACCESS_TOKEN=substitua-pelo-access-token


# ============================================================
# MERCADO PAGO
# ============================================================

# API oficial do Mercado Pago.
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# Obrigatório em produção.
# Utilize credenciais de teste durante o desenvolvimento.
MERCADO_PAGO_ACCESS_TOKEN=substitua-pelo-access-token

# Obrigatório em produção.
# Utilizado para validar a assinatura dos webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=substitua-pela-chave-do-webhook


# ============================================================
# GOOGLE LOGIN
# ============================================================

# Client ID OAuth 2.0 do tipo "Aplicativo da Web".
# Obrigatório em produção.
#
# O Client ID não é tratado como segredo, mas deve corresponder
# ao ambiente e aos domínios autorizados corretamente.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com


# ============================================================
# ADMINISTRADOR INICIAL
# ============================================================

# Utilizados somente ao executar:
# npm run seed

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com

# Deve possuir no mínimo 12 caracteres.
# Nunca salve a senha real de produção no repositório.
ADMIN_PASSWORD=substitua-por-uma-senha-segura


# ============================================================
# PEDIDOS
# ============================================================

# Tempo máximo, em minutos, para um pedido permanecer
# PENDENTE aguardando pagamento.
#
# Valores aceitos: 5 até 1440.
PENDING_ORDER_EXPIRATION_MINUTES=30
