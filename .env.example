# Ambiente da aplicação
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mel

# JWT
# Use no mínimo 32 caracteres. Em produção, gere um segredo aleatório forte.
JWT_SECRET=substitua-por-um-segredo-seguro-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=1d

# Servidor
PORT=3000

# Frontend autorizado pelo CORS
FRONTEND_URL=http://localhost:5173

# Cloudinary
# Obtenha estes valores no painel da sua conta Cloudinary.
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret

# Frete
# CEP de origem dos pedidos, somente números.
# Sítio Macajetuba II - Viçosa do Ceará/CE
SHIPPING_ORIGIN_ZIP_CODE=62300000

# Melhor Envio
# Durante o desenvolvimento, utilize o ambiente Sandbox.
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br

# Nome da aplicação e e-mail técnico enviados no User-Agent da API.
MELHOR_ENVIO_USER_AGENT=Apiario Vitoria Seven (apiariovitoriaseven@gmail.com)

# Access Token OAuth do Melhor Envio.
# Nunca envie o token real para o repositório.
# MELHOR_ENVIO_ACCESS_TOKEN=

# Mercado Pago
# API oficial utilizada pelo Checkout Pro.
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# Access Token da aplicação do Mercado Pago.
# Use credenciais de teste durante o desenvolvimento.
# Nunca envie o token real para o repositório.
# MERCADO_PAGO_ACCESS_TOKEN=

# Chave secreta utilizada para validar a assinatura dos Webhooks.
# Nunca envie a chave real para o repositório.
# MERCADO_PAGO_WEBHOOK_SECRET=

# Google Login
# Client ID OAuth 2.0 do tipo "Aplicativo da Web".
# O Client ID não é segredo, mas mantenha cada ambiente configurado corretamente.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Administrador inicial utilizado pelo seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=substitua-por-uma-senha-segura

# Pedidos
# Tempo máximo para um pedido permanecer PENDENTE aguardando pagamento.
PENDING_ORDER_EXPIRATION_MINUTES=30